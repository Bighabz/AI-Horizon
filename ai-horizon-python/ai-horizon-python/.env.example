# AI Horizon backend environment variables.
# Copy to .env and fill in real values. NEVER commit .env.
# In production (Railway), set these in the service's Variables tab instead of a file.

# Gemini API keys. Only GEMINI_API_KEY is required; _2/_3 are optional extra keys
# from DIFFERENT Google Cloud projects, used for quota rotation on rate limits.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# Gemini File Search store names (created by scripts/setup_file_stores.py).
DCWF_STORE_NAME=fileSearchStores/your-dcwf-store-id
# Store for AI-impact evidence (articles/research). Legacy alias: ARTIFACTS_STORE_NAME.
EVIDENCE_STORE_NAME=fileSearchStores/your-evidence-store-id
# Store for training/certification resources.
RESOURCES_STORE_NAME=fileSearchStores/your-resources-store-id

# Optional: YouTube Data API key (only needed for private/edge-case videos).
YOUTUBE_API_KEY=

# Optional: Dumpling.ai API key - fallback web scraper when trafilatura is blocked.
DUMPLING_API_KEY=

# Logging level (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO

# Admin API key for protected endpoints (e.g. /api/file-stores/stats). Any long random string.
ADMIN_API_KEY=generate_a_long_random_string

# Railway PostgreSQL connection string (Railway injects this automatically in production;
# the internal postgres.railway.internal host only resolves inside Railway).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Railway PostgreSQL PUBLIC connection string - for local scripts/migrations only.
RAILWAY_DATABASE_URL=postgresql://user:password@public-host:port/dbname
